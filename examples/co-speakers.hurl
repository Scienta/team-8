# Co-speakers: our own examples (workflow/specs/co-speakers.md). Rule numbers refer to that spec.
# Run: hurl --test --variable base_url=http://localhost:8080 co-speakers.hurl

# Setup: a main speaker with a talk, and three other speakers
POST {{base_url}}/speakers
{ "name": "Main Speaker", "email": "main-{{newUuid}}@example.com" }
HTTP 201
[Captures]
main_id: jsonpath "$.id"

POST {{base_url}}/speakers
{ "name": "Co One", "email": "co1-{{newUuid}}@example.com" }
HTTP 201
[Captures]
co1_id: jsonpath "$.id"

POST {{base_url}}/speakers
{ "name": "Co Two", "email": "co2-{{newUuid}}@example.com" }
HTTP 201
[Captures]
co2_id: jsonpath "$.id"

POST {{base_url}}/speakers
{ "name": "Co Three", "email": "co3-{{newUuid}}@example.com" }
HTTP 201
[Captures]
co3_id: jsonpath "$.id"

# R6: a new talk has no co-speakers
POST {{base_url}}/talks
{ "title": "Pairing on stage", "format": "PRESENTATION", "level": "BEGINNER", "speakerId": {{main_id}} }
HTTP 201
[Captures]
talk_id: jsonpath "$.id"
[Asserts]
jsonpath "$.coSpeakerIds" count == 0

# R2, R6: add two co-speakers, listed in the order they were added
PUT {{base_url}}/talks/{{talk_id}}/co-speakers/{{co2_id}}
HTTP 200
[Asserts]
jsonpath "$.id" == {{talk_id}}
jsonpath "$.speakerId" == {{main_id}}
jsonpath "$.coSpeakerIds" count == 1
jsonpath "$.coSpeakerIds[0]" == {{co2_id}}

PUT {{base_url}}/talks/{{talk_id}}/co-speakers/{{co1_id}}
HTTP 200
[Asserts]
jsonpath "$.coSpeakerIds" count == 2
jsonpath "$.coSpeakerIds[0]" == {{co2_id}}
jsonpath "$.coSpeakerIds[1]" == {{co1_id}}

# R7: adding an existing co-speaker changes nothing
PUT {{base_url}}/talks/{{talk_id}}/co-speakers/{{co2_id}}
HTTP 200
[Asserts]
jsonpath "$.coSpeakerIds" count == 2
jsonpath "$.coSpeakerIds[0]" == {{co2_id}}

# R4: a third is a conflict
PUT {{base_url}}/talks/{{talk_id}}/co-speakers/{{co3_id}}
HTTP 409

# R5: the main speaker can't co-speak their own talk
PUT {{base_url}}/talks/{{talk_id}}/co-speakers/{{main_id}}
HTTP 409

# R8: a co-speaker's own talk list doesn't include the talk
GET {{base_url}}/speakers/{{co1_id}}/talks
HTTP 200
[Asserts]
jsonpath "$" count == 0

# R3: remove one
DELETE {{base_url}}/talks/{{talk_id}}/co-speakers/{{co2_id}}
HTTP 200
[Asserts]
jsonpath "$.coSpeakerIds" count == 1
jsonpath "$.coSpeakerIds[0]" == {{co1_id}}

# R6: GET shows the same
GET {{base_url}}/talks/{{talk_id}}
HTTP 200
[Asserts]
jsonpath "$.coSpeakerIds" count == 1
jsonpath "$.coSpeakerIds[0]" == {{co1_id}}

# Errors: unknown talk or speaker
PUT {{base_url}}/talks/2147483000/co-speakers/{{co1_id}}
HTTP 404

PUT {{base_url}}/talks/{{talk_id}}/co-speakers/2147483000
HTTP 404
